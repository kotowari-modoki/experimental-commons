---
// ABOUTME: Renders a searchable directory of all published tags ordered by article count.
// ABOUTME: Gives readers and crawlers a central hub to explore topics across the knowledge garden.
import { getCollection } from 'astro:content';
import SocialImage from '../../components/SocialImage.astro';
import { createTagIndexImage } from '../../lib/og-image.js';
import { buildTagDirectory } from '../../lib/navigation.js';
import { SITE_NAME, buildSiteUrl, serializeJsonLd } from '../../lib/structured-data.js';

const docs = await getCollection('docs');
const tags = buildTagDirectory(docs);
const site = Astro.site ?? new URL('https://kotowari-modoki.github.io/');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const image = createTagIndexImage();
const canonical = new URL(Astro.url.pathname, site).href;
const homeUrl = buildSiteUrl(site, base);
const sitemapUrl = buildSiteUrl(site, base, 'sitemap-index.xml');
const llmsTxtUrl = buildSiteUrl(site, base, 'llms.txt');
const rssUrl = buildSiteUrl(site, base, 'rss.xml');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'すべてのタグ',
      description: image.description,
      url: canonical,
      inLanguage: 'ja',
      isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: homeUrl },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: tags.length,
        itemListElement: tags.slice(0, 50).map(({ tag }, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: `#${tag}`,
          url: buildSiteUrl(site, base, `tags/${tag}/`),
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE_NAME, item: homeUrl },
        { '@type': 'ListItem', position: 2, name: 'すべてのタグ', item: canonical },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>すべてのタグ — experimental-commons</title>
    <meta name="description" content={image.description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={sitemapUrl} />
    <link rel="shortcut icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="text/plain" title="LLMs.txt" href={llmsTxtUrl} />
    <link rel="alternate" type="application/rss+xml" title="experimental-commons RSS" href={rssUrl} />
    <meta property="og:title" content={image.title} />
    <meta property="og:description" content={image.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="experimental-commons" />
    <meta property="og:locale" content="ja" />
    <meta name="twitter:card" content="summary_large_image" />
    <SocialImage image={image} />
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
    <style>
      :root {
        color-scheme: light dark;
        --bg: #ffffff;
        --surface: #f5f6f8;
        --text: #181a1f;
        --muted: #5c6370;
        --border: #d8dce3;
        --accent: #3b5bdb;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0d0e14;
          --surface: #151722;
          --text: #e4e7eb;
          --muted: #9ca3af;
          --border: #2a2e3f;
          --accent: #8da2fb;
        }
      }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        max-width: 56rem;
        margin: 2rem auto;
        padding: 0 1.25rem 3rem;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
      }
      .top-nav {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        font-size: 0.875rem;
      }
      .top-nav a {
        color: var(--muted);
        text-decoration: none;
      }
      .top-nav a:hover {
        color: var(--accent);
        text-decoration: underline;
      }
      h1 {
        font-size: 1.75rem;
        margin: 0 0 0.4rem;
      }
      .subtitle {
        color: var(--muted);
        margin: 0 0 1.25rem;
        font-size: 0.95rem;
      }
      .filter-box {
        width: 100%;
        box-sizing: border-box;
        padding: 0.65rem 0.9rem;
        margin-bottom: 1.5rem;
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        background: var(--surface);
        color: var(--text);
        font-size: 0.95rem;
      }
      .tag-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
      }
      .tag-item a {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.4rem 0.75rem;
        border: 1px solid var(--border);
        border-radius: 999rem;
        background: var(--surface);
        color: var(--text);
        text-decoration: none;
        font-size: 0.875rem;
      }
      .tag-item a:hover {
        border-color: var(--accent);
        color: var(--accent);
      }
      .tag-count {
        font-size: 0.75rem;
        color: var(--muted);
        font-variant-numeric: tabular-nums;
      }
      .empty-state {
        display: none;
        color: var(--muted);
        margin-top: 1rem;
      }
    </style>
  </head>
  <body>
    <nav class="top-nav" aria-label="Breadcrumb">
      <a href={`${base}/`}>← experimental-commons</a>
    </nav>
    <h1>すべてのタグ</h1>
    <p class="subtitle">全 {tags.length} タグ（記事数順）</p>
    <input
      id="tag-filter"
      class="filter-box"
      type="search"
      placeholder="タグ名で絞り込む（例: ai, math, philosophy）"
      aria-label="タグ名で絞り込む"
    />
    <ul class="tag-list" id="tag-list">
      {tags.map(({ tag, count }) => (
        <li class="tag-item" data-tag={tag.toLowerCase()}>
          <a href={`${base}/tags/${tag}/`}>
            <span>#{tag}</span>
            <span class="tag-count">{count}</span>
          </a>
        </li>
      ))}
    </ul>
    <p id="empty-state" class="empty-state">一致するタグが見つかりませんでした。</p>
    <script is:inline>
      const input = document.getElementById('tag-filter');
      const items = Array.from(document.querySelectorAll('#tag-list .tag-item'));
      const empty = document.getElementById('empty-state');
      input?.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        let visible = 0;
        for (const item of items) {
          const match = !q || (item.dataset.tag || '').includes(q);
          item.style.display = match ? '' : 'none';
          if (match) visible += 1;
        }
        if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
      });
    </script>
  </body>
</html>
