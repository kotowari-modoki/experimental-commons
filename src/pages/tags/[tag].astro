---
// ABOUTME: Generates a static page for each tag listing all docs entries with that tag.
// ABOUTME: Provides entry points for tag-based browsing of the knowledge garden.
import { getCollection } from 'astro:content';
import SocialImage from '../../components/SocialImage.astro';
import { formatPageDate, getStatusEmoji } from '../../components/page-metadata.js';
import { createTagImage } from '../../lib/og-image.js';
import { buildSiteUrl, buildTagJsonLd, serializeJsonLd } from '../../lib/structured-data.js';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const tagSet = new Set(docs.flatMap((entry) => entry.data.tags ?? []));
  const toTime = (value: Date | string | undefined) => {
    const t = value ? new Date(value).getTime() : -Infinity;
    return Number.isNaN(t) ? -Infinity : t;
  };

  return Array.from(tagSet).map((tag) => ({
    params: { tag },
    props: {
      tag,
      entries: docs
        .filter((entry) => !entry.data.draft && (entry.data.tags ?? []).includes(tag))
        .sort((a, b) => toTime(b.data.date) - toTime(a.data.date)),
    },
  }));
}

const { tag, entries } = Astro.props;
// entry.id is the correct field for Astro content collections v2 (docsLoader API),
// equivalent to the path relative to the content root without extension.
const site = Astro.site ?? new URL('https://kotowari-modoki.github.io/');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const image = createTagImage(tag);
const canonical = new URL(Astro.url.pathname, site).href;
const sitemapUrl = buildSiteUrl(site, base, 'sitemap-index.xml');
const llmsTxtUrl = buildSiteUrl(site, base, 'llms.txt');
const rssUrl = buildSiteUrl(site, base, 'rss.xml');
const jsonLd = buildTagJsonLd({ tag, entries, url: canonical, site, base });
// Avoid indexing thin single-article tag archives while keeping links crawlable.
const robotsContent = entries.length >= 2 ? 'index, follow' : 'noindex, follow';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>#{tag} — experimental-commons</title>
    <meta name="description" content={image.description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={sitemapUrl} />
    <link rel="shortcut icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="text/plain" title="LLMs.txt" href={llmsTxtUrl} />
    <link rel="alternate" type="application/rss+xml" title="experimental-commons RSS" href={rssUrl} />
    <meta property="og:title" content={image.title} />
    <meta property="og:description" content={image.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="experimental-commons" />
    <meta property="og:locale" content="ja" />
    <meta name="twitter:card" content="summary_large_image" />
    <SocialImage image={image} />
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
    <style>
      :root {
        color-scheme: light dark;
        --bg: #ffffff;
        --surface: #f5f6f8;
        --text: #181a1f;
        --muted: #5c6370;
        --border: #d8dce3;
        --accent: #3b5bdb;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0d0e14;
          --surface: #151722;
          --text: #e4e7eb;
          --muted: #9ca3af;
          --border: #2a2e3f;
          --accent: #8da2fb;
        }
      }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        max-width: 52rem;
        margin: 2rem auto;
        padding: 0 1.25rem 3rem;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
      }
      .top-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
        font-size: 0.875rem;
      }
      .top-nav a {
        color: var(--muted);
        text-decoration: none;
      }
      .top-nav a:hover {
        color: var(--accent);
        text-decoration: underline;
      }
      h1 {
        font-size: 1.75rem;
        margin: 0 0 0.35rem;
      }
      .count {
        color: var(--muted);
        font-size: 0.9rem;
        margin: 0 0 1.5rem;
      }
      ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }
      li a {
        display: block;
        padding: 0.95rem 1.1rem;
        border: 1px solid var(--border);
        border-radius: 0.6rem;
        background: var(--surface);
        color: var(--text);
        text-decoration: none;
        transition: border-color 0.15s ease;
      }
      li a:hover {
        border-color: var(--accent);
      }
      .entry-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
      }
      .entry-title {
        font-weight: 600;
        font-size: 1rem;
      }
      .entry-meta {
        flex-shrink: 0;
        font-size: 0.8rem;
        color: var(--muted);
        font-variant-numeric: tabular-nums;
      }
      .entry-desc {
        margin: 0.4rem 0 0;
        font-size: 0.875rem;
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <nav class="top-nav" aria-label="Breadcrumb">
      <a href={`${base}/`}>← experimental-commons</a>
      <a href={`${base}/tags/`}>すべてのタグ一覧</a>
    </nav>
    <h1>#{tag}</h1>
    <p class="count">{entries.length} 件のページ</p>
    <ul>
      {entries.map((entry) => (
        <li>
          <a href={`${base}/${entry.id}/`}>
            <div class="entry-header">
              <span class="entry-title">
                {getStatusEmoji(entry.data.status)} {entry.data.title}
              </span>
              <span class="entry-meta">
                {entry.data.status}
                {formatPageDate(entry.data.date) ? ` · ${formatPageDate(entry.data.date)}` : ''}
              </span>
            </div>
            {entry.data.description && <p class="entry-desc">{entry.data.description}</p>}
          </a>
        </li>
      ))}
    </ul>
  </body>
</html>
