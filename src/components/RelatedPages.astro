---
// ABOUTME: Displays related pages ranked by shared tags and recency for the current article.
// ABOUTME: Excludes drafts and system pages while surfacing status and publication dates.
import { getCollection } from 'astro:content';
import { selectRelatedDocs } from '../lib/navigation.js';
import { formatPageDate, getStatusEmoji } from './page-metadata.js';

interface Props {
  /** entry.id format: e.g. "history/kojiki-nihon-shoki-history" (no extension, no leading slash) */
  currentSlug: string;
  tags: string[];
  limit?: number;
}

const { currentSlug, tags, limit = 4 } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const related =
  tags.length === 0
    ? []
    : selectRelatedDocs(await getCollection('docs'), currentSlug, tags, limit);
---

{
  related.length > 0 && (
    <aside class="related-pages" aria-label="Related pages">
      <h2>関連ページ</h2>
      <ul>
        {related.map((entry) => (
          <li>
            <a href={`${base}/${entry.id}/`}>
              <span class="related-title">
                {getStatusEmoji(entry.data.status)} {entry.data.title}
              </span>
              {formatPageDate(entry.data.date) && (
                <time class="related-date">{formatPageDate(entry.data.date)}</time>
              )}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .related-pages {
    margin-top: 2.5rem;
    margin-bottom: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .related-pages h2 {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
    margin: 0 0 0.75rem;
  }

  .related-pages ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .related-pages a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0.6rem;
    border-radius: 0.375rem;
    color: var(--sl-color-text);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .related-pages a:hover {
    background: var(--sl-color-bg-nav);
    text-decoration: underline;
  }

  .related-title {
    min-width: 0;
  }

  .related-date {
    flex-shrink: 0;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-gray-3);
  }
</style>
