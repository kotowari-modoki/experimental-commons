---
// ABOUTME: Renders the Starlight article title, breadcrumbs, metadata badges, and clickable tags.
// ABOUTME: Surfaces page maturity, parent navigation, and tag exploration directly in the header.
import { getPageMetadata } from './page-metadata.js';
import { buildBreadcrumbs } from '../lib/navigation.js';

const entry = Astro.locals.starlightRoute.entry;
const entryData = Astro.locals.starlightRoute.entry.data;
const metadata = getPageMetadata(entryData);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const breadcrumbs = buildBreadcrumbs(entry, base);
const tags = entry.id === '404' ? [] : (entryData.tags ?? []);
const EXCLUDED_MD_IDS = new Set(['', 'index', '404', 'research/journal-template']);
const markdownPath =
	!entryData.draft && !EXCLUDED_MD_IDS.has(entry.id) ? `${base}/${entry.id}.md` : null;
---

{
	breadcrumbs.length > 0 && (
		<nav class="page-breadcrumbs" aria-label="Breadcrumb">
			<ol>
				{breadcrumbs.map((crumb, index) => (
					<li>
						{index > 0 && <span class="breadcrumb-sep" aria-hidden="true">/</span>}
						{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}
					</li>
				))}
			</ol>
		</nav>
	)
}
<h1 id="_top">{entryData.title}</h1>
{
	(metadata.length > 0 || markdownPath) && (
		<div class="page-meta-row">
			{metadata.length > 0 && (
				<div class="page-meta" aria-label="Page metadata">
					{metadata.map((item) => (
						<div class="page-meta-item">
							<span class="page-meta-label">{item.label}</span>
							<span class="page-meta-value">{item.value}</span>
						</div>
					))}
				</div>
			)}
			{markdownPath && (
				<div class="page-actions" aria-label="Markdown actions">
					<button type="button" class="page-action-btn" data-copy-markdown={markdownPath}>
						Markdownをコピー
					</button>
					<a class="page-action-link" href={markdownPath}>
						.md
					</a>
				</div>
			)}
		</div>
	)
}
{
	tags.length > 0 && (
		<nav class="page-tags" aria-label="Tags">
			{tags.map((tag) => (
				<a class="page-tag" href={`${base}/tags/${tag}/`}>
					#{tag}
				</a>
			))}
		</nav>
	)
}

<style>
	.page-breadcrumbs {
		margin-bottom: 0.6rem;
		font-size: 0.85rem;
		color: var(--sl-color-gray-3);
	}

	.page-breadcrumbs ol {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.page-breadcrumbs li {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.page-breadcrumbs a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}

	.page-breadcrumbs a:hover {
		color: var(--sl-color-accent-high);
		text-decoration: underline;
	}

	.breadcrumb-sep {
		color: var(--sl-color-gray-4);
	}

	.page-meta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 0.9rem;
	}

	.page-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.page-actions {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.page-action-btn,
	.page-action-link {
		display: inline-flex;
		align-items: center;
		padding: 0.35rem 0.7rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.4rem;
		background: var(--sl-color-bg-nav);
		color: var(--sl-color-gray-2);
		font-size: 0.8rem;
		line-height: 1.2;
		text-decoration: none;
		cursor: pointer;
		transition: border-color 0.15s ease, color 0.15s ease;
	}

	.page-action-btn:hover,
	.page-action-link:hover {
		border-color: var(--sl-color-accent-high);
		color: var(--sl-color-accent-high);
	}

	.page-meta-item {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.35rem 0.7rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999rem;
		background: var(--sl-color-bg-nav);
		color: var(--sl-color-gray-2);
		font-size: 0.875rem;
		line-height: 1;
	}

	.page-meta-label {
		color: var(--sl-color-gray-3);
		font-weight: 600;
		text-transform: lowercase;
	}

	.page-meta-value {
		color: var(--sl-color-text);
		font-weight: 600;
	}

	.page-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 0.7rem;
	}

	.page-tag {
		display: inline-flex;
		align-items: center;
		padding: 0.2rem 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		background: transparent;
		color: var(--sl-color-gray-2);
		font-size: 0.8rem;
		line-height: 1.3;
		text-decoration: none;
		transition: border-color 0.15s ease, color 0.15s ease;
	}

	.page-tag:hover {
		border-color: var(--sl-color-accent-high);
		color: var(--sl-color-accent-high);
	}

	@media (max-width: 40rem) {
		.page-meta {
			gap: 0.5rem;
		}

		.page-meta-item {
			width: 100%;
			justify-content: space-between;
		}
	}
</style>

<script>
	const bindCopyButtons = () => {
		for (const button of document.querySelectorAll('button[data-copy-markdown]')) {
			if (!(button instanceof HTMLButtonElement) || button.dataset.bound === 'true') continue;
			button.dataset.bound = 'true';
			button.addEventListener('click', async () => {
				const url = button.dataset.copyMarkdown;
				if (!url) return;
				const defaultLabel = button.textContent ?? 'Markdownをコピー';
				try {
					const response = await fetch(url);
					if (!response.ok) throw new Error(`HTTP ${response.status}`);
					const text = await response.text();
					await navigator.clipboard.writeText(text);
					button.textContent = 'コピーしました';
					setTimeout(() => {
						button.textContent = defaultLabel;
					}, 1800);
				} catch {
					window.location.href = url;
				}
			});
		}
	};

	bindCopyButtons();
	document.addEventListener('astro:page-load', bindCopyButtons);
</script>
